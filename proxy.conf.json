{
  "/replicate-api": {
    "target": "https://api.replicate.com",
    "secure": true,
    "changeOrigin": true,
    "pathRewrite": {
      "^/replicate-api": ""
    },
    "logLevel": "warn",
    "headers": {
      "Connection": "keep-alive"
    }
  },
  "/openwa-api": {
    "target": "http://localhost:3000",
    "secure": false,
    "changeOrigin": true,
    "pathRewrite": {
      "^/openwa-api": ""
    },
    "logLevel": "warn"
  }
}
